/* Layout: header sticky + menu, satu halaman tampil per kali (diganti lewat #hash), konten kolom 960px.
   Palet: navy malam + emas. */
:root{
  color-scheme:dark;
  --bg:#070d1c;
  --surface:#0f1a36;
  --surface-2:#16244a;
  --fg:#ebeefa;
  --muted:#9fabc9;
  --line:#26365f;
  --accent:#d4af37;
  --accent-light:#f0d77a;
  --accent-soft:#2f2a14;
  --on-accent:#070d1c;
  --display:"Cinzel","Trajan Pro",Georgia,serif;
  --body:"Inter",system-ui,-apple-system,"Segoe UI",sans-serif;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--body);font-size:16px;line-height:1.65}
a{color:inherit}
h1,h2,h3{font-family:var(--display);font-weight:600;line-height:1.2;margin:0;text-wrap:balance}
p{margin:0;max-width:65ch}
.wrap{max-width:960px;margin-inline:auto;padding-inline:16px}
img,svg{display:block}

/* Header */
.site-head{position:sticky;top:0;z-index:20;background:var(--surface);border-bottom:1px solid var(--line)}
.head-row{display:flex;align-items:center;gap:16px;padding-block:10px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;flex:none}
.brand .logo{width:34px;height:34px}
.brand b{font-family:var(--display);font-size:1rem;letter-spacing:.08em;text-transform:uppercase;color:var(--accent-light)}
.menu{display:flex;gap:4px;overflow-x:auto;margin-left:auto;min-width:0;scrollbar-width:thin}
.menu a{text-decoration:none;font-size:.85rem;font-weight:500;padding:8px 12px;border-radius:6px;color:var(--muted);white-space:nowrap}
.menu a:hover{color:var(--fg);background:var(--surface-2)}
.menu a[aria-current="page"]{color:var(--accent);background:var(--accent-soft)}
a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
@media(max-width:720px){.head-row{flex-wrap:wrap;gap:4px}.menu{margin-left:0;width:100%;padding-bottom:4px}}

/* Pages */
main{padding-block:40px 56px}
.page[hidden]{display:none}
.stack{display:flex;flex-direction:column;gap:28px}
.eyebrow{font-size:.75rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--accent)}
.page-title{font-size:clamp(1.8rem,5vw,2.6rem);margin-block:8px 12px;letter-spacing:.03em;color:var(--accent-light)}
.lead{color:var(--muted);font-size:1.05rem}
.sec-title{font-size:1.2rem;letter-spacing:.08em;color:var(--accent);text-transform:uppercase}
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.grid>*{min-width:0}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:20px}
.panel h3{font-size:1.05rem;margin-bottom:6px;letter-spacing:.03em;color:var(--accent-light)}
.panel p{color:var(--muted);font-size:.95rem}
.ph{color:var(--muted);font-style:italic}
.tag{display:inline-block;font-size:.72rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:3px 9px;border-radius:99px;background:var(--accent-soft);color:var(--accent);margin-bottom:10px}
.note{font-size:.85rem;color:var(--muted);border-left:3px solid var(--accent);padding:4px 0 4px 12px;max-width:65ch}

/* Beranda */
.hero{
  border:1px solid var(--line);border-radius:10px;
  background:radial-gradient(ellipse at 50% 0%,rgba(212,175,55,.16),transparent 65%),linear-gradient(180deg,var(--surface-2),var(--bg));
  padding:28px 16px 36px;
}
.hero-row{display:grid;grid-template-columns:auto 1fr auto;gap:clamp(8px,3vw,32px);align-items:start}
.banner{width:clamp(56px,12vw,120px);align-self:start}
.banner img,.banner svg{width:100%;height:auto}
.hero-center{text-align:center;display:flex;flex-direction:column;align-items:center;gap:14px;padding-top:12px}
.hero-center .logo{width:clamp(84px,18vw,130px);height:clamp(84px,18vw,130px)}
.hero-center .sub{color:var(--muted);letter-spacing:.2em;text-transform:uppercase;font-size:.78rem;font-weight:500}
.hero-center h1{font-size:clamp(1.7rem,5.5vw,3rem);letter-spacing:.05em;text-transform:uppercase;color:var(--accent-light)}
.motto{font-family:var(--display);font-size:clamp(1.05rem,3vw,1.5rem);color:var(--accent);letter-spacing:.08em}
.cta-row{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-top:6px}
.cta{display:inline-block;padding:11px 22px;border-radius:6px;font-weight:600;text-decoration:none;font-size:.9rem;border:1px solid var(--accent)}
.cta.solid{background:var(--accent);color:var(--on-accent)}
.cta.solid:hover{filter:brightness(1.08)}
.cta.ghost{color:var(--accent)}
.cta.ghost:hover{background:var(--accent-soft)}
.cta.off{opacity:.55}
.tiles a{text-decoration:none;display:block}
.tiles .panel{height:100%;transition:border-color .2s}
.tiles a:hover .panel{border-color:var(--accent)}

/* Castellan / staff */
.tier{display:flex;flex-direction:column;gap:14px}
.tier-desc{color:var(--muted);font-size:.95rem;max-width:70ch}
.pos{display:flex;flex-direction:column;gap:12px}
.pos-head h3{margin:0 0 4px}
.pos-head p{margin:0}
.members{display:flex;flex-direction:column;gap:10px}
.member{display:grid;grid-template-columns:44px 1fr auto;gap:12px;align-items:center;padding:10px 12px;border:1px solid var(--line);border-radius:8px;background:var(--bg)}
.avatar{width:44px;height:44px;border-radius:50%;border:2px solid var(--accent);display:grid;place-items:center;font-family:var(--display);color:var(--accent);font-size:1.1rem;background:var(--surface)}
.m-info b{color:var(--fg)}
.m-info .sub{color:var(--muted);font-size:.85rem}
.m-id{color:var(--muted);font-size:.8rem}
.status{font-size:.78rem;color:var(--muted)}
.status::before{content:"● ";font-size:.65rem}
.status.on{color:#7bd88f}
.m-links{display:flex;gap:6px}
.chip{border:1px solid var(--accent);color:var(--accent);padding:2px 10px;border-radius:99px;font-size:.75rem;font-weight:600;text-decoration:none}
a.chip:hover{background:var(--accent-soft)}
.chip.off{border-color:var(--line);color:var(--muted);opacity:.7;cursor:default}
.empty{padding:14px;border:1px dashed var(--line);border-radius:8px;color:var(--muted);font-style:italic;font-size:.9rem;text-align:center}
@media(max-width:480px){.member{grid-template-columns:44px 1fr}.m-links{grid-column:2}}

/* System */
.pts{width:100%;border-collapse:collapse;margin-top:8px}
.pts td{padding:9px 0;border-bottom:1px solid var(--line);font-size:.95rem}
.pts td:last-child{text-align:right;color:var(--accent-light);font-family:var(--display)}
.rank-range{font-family:var(--display);color:var(--accent-light);font-size:.95rem;margin:2px 0 8px}

/* Uniform */
.uniform{text-align:center}
.img-box{aspect-ratio:3/4;border:1px dashed var(--line);border-radius:6px;margin-bottom:14px;display:grid;place-items:center;color:var(--muted);font-style:italic;font-size:.9rem;overflow:hidden;background:repeating-linear-gradient(45deg,transparent 0 12px,rgba(212,175,55,.04) 12px 24px)}
.img-box img{width:100%;height:100%;object-fit:cover}
.uniform .uname{color:var(--muted);font-size:.95rem}

/* Chronicles */
.season{border:1px solid var(--accent);background:var(--surface);border-radius:10px;padding:24px;display:flex;flex-direction:column;gap:12px}
.season h3{font-size:1.5rem;color:var(--accent-light)}
.checks{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px}
.checks li{padding-left:22px;position:relative;color:var(--muted);font-size:.95rem}
.checks li::before{content:"";position:absolute;left:3px;top:.62em;width:8px;height:8px;background:var(--accent);transform:rotate(45deg)}
.locked{border-style:dashed;border-color:var(--line);opacity:.55}
.locked h3{color:var(--muted)}
.soon{font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}

/* Judul halaman + sub judul (Lore) */
.page-title:has(+ .page-subtitle){margin-bottom:4px}
.page-subtitle{font-size:clamp(1.05rem,3vw,1.4rem);letter-spacing:.05em;color:var(--accent);margin-bottom:12px}

/* Kotak besar untuk satu tier (dipakai Segate) */
.tier-box{gap:14px}
.tier-box>.sec-title{font-size:1.2rem;color:var(--accent);text-transform:uppercase;margin:0}
.tier-box .panel{background:var(--bg)}

footer{border-top:1px solid var(--line);padding-block:28px;text-align:center;background:var(--surface)}
footer .motto{font-size:1rem}
footer small{display:block;margin-top:6px;color:var(--muted);font-size:.8rem}
